# PostgreSQL container settings
POSTGRES_USER=skyhaler
POSTGRES_PASSWORD=skyhaler
POSTGRES_DB=skyhaler

# Host port published by the db service. Must match the port in DATABASE_URL.
# Use 5433 (and the URL below) if a local PostgreSQL already listens on 5432.
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://skyhaler:skyhaler@localhost:5432/skyhaler

# Google Earth Engine (processing/). Shared Cloud project ID for Earth Engine (not secret).
GEE_PROJECT=skyhaler
# Optional: path to a GEE service account JSON key (outside git). Leave empty to use `earthengine authenticate`.
GEE_SERVICE_ACCOUNT_KEY=
